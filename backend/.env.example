# Models. Production and the default local setup call DeepInfra (OpenAI-compatible); one
# DeepInfra key serves the LLM, the embedding and the reranker. Any OpenAI-compatible server
# works for the LLM: set BASE_URL. There is no built-in LLM model. Every role uses MODEL
# below unless it sets its own, and with a key but no model the API does not start.
PHARMA_LLM__DEFAULT__BASE_URL=https://api.deepinfra.com/v1/openai
PHARMA_LLM__DEFAULT__API_KEY=
PHARMA_LLM__DEFAULT__MODEL=Qwen/Qwen3.5-9B
# Qwen3.5 thinks by default; the pipeline wants direct answers (sent as the SDK's extra_body).
PHARMA_LLM__DEFAULT__EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Output cap per call (DeepInfra names the field max_tokens). It stops a runaway generation;
# a structured step that hits it is skipped like any failed step. Reasoning tokens of a
# thinking model count toward it, so it leaves room for thinking on every role.
PHARMA_LLM__DEFAULT__MAX_TOKENS_PARAM=max_tokens
PHARMA_LLM__DEFAULT__MAX_OUTPUT_TOKENS=8192
# Per-role override example (another model for the answer step):
# PHARMA_LLM__ROLES__ANSWER__MODEL=Qwen/Qwen3.5-27B
# Reasoning effort is sent only when set (many OpenAI-compatible servers reject it):
# PHARMA_LLM__ROLES__JUDGE__REASONING_EFFORT=medium
#
# Gemini through the cli-proxy-api gateway (compose.gemini-proxy.yaml): the key is one of
# api-keys in devops/cli-proxy-api/config.yaml; inside compose the base URL is set for you.
# PHARMA_LLM__DEFAULT__BASE_URL=http://127.0.0.1:8317/v1
# PHARMA_LLM__DEFAULT__MODEL=gemini-3.8-flash-high
# PHARMA_LLM__ROLES__GUARDRAIL__MODEL=gemini-3.1-flash-lite
# PHARMA_LLM__ROLES__REPHRASE__MODEL=gemini-3.1-flash-lite

# Retrieval. Corpus text lives in Postgres schema `corpus`; Qdrant holds the index.
# Load data with: uv run pharma-agent corpus import <bundle_dir> --collection formulary --publish
PHARMA_QDRANT__URL=http://localhost:6333
# PHARMA_QDRANT__API_KEY=                          # Qdrant Cloud
PHARMA_RETRIEVAL__QDRANT_COLLECTION=chunks_current
# Collections searched by runs without a user (pharma-lab, CLI ask/check); chat over the
# API searches what the signed-in user may see.
# PHARMA_RETRIEVAL__COLLECTIONS=["formulary"]
PHARMA_RETRIEVAL__EMBEDDING__BASE_URL=https://api.deepinfra.com/v1/openai
PHARMA_RETRIEVAL__EMBEDDING__MODEL=Qwen/Qwen3-Embedding-4B
PHARMA_RETRIEVAL__EMBEDDING__DIMENSION=2560
PHARMA_RETRIEVAL__EMBEDDING__API_KEY=
# PHARMA_RETRIEVAL__EMBEDDING__TIMEOUT_SECONDS=60
# PHARMA_RETRIEVAL__EMBEDDING__MAX_RETRIES=2
PHARMA_RETRIEVAL__RERANK__PROTOCOL=deepinfra
PHARMA_RETRIEVAL__RERANK__BASE_URL=https://api.deepinfra.com
PHARMA_RETRIEVAL__RERANK__MODEL=Qwen/Qwen3-Reranker-4B
PHARMA_RETRIEVAL__RERANK__API_KEY=               # sent as "Authorization: Bearer <key>"
# PHARMA_RETRIEVAL__RERANK__MAX_CANDIDATES=40      # candidates scored per search round
# PHARMA_RETRIEVAL__RERANK__MAX_CONCURRENT=2       # concurrent rerank requests, each with a whole search round
# PHARMA_RETRIEVAL__RERANK__TIMEOUT_SECONDS=120
#
# The same models on this machine with llama.cpp (compose.local-models.yaml, CPU only).
# These are also the built-in values of every embedding and rerank setting left unset:
# PHARMA_RETRIEVAL__EMBEDDING__BASE_URL=http://localhost:11434/v1
# PHARMA_RETRIEVAL__EMBEDDING__MODEL=qwen3-embedding:4b-fp16
# PHARMA_RETRIEVAL__RERANK__PROTOCOL=native_rerank
# PHARMA_RETRIEVAL__RERANK__BASE_URL=http://localhost:11435
# PHARMA_RETRIEVAL__RERANK__MODEL=qwen3-reranker:4b-fp16

# Langfuse (optional)
# PHARMA_LANGFUSE__PUBLIC_KEY=pk-lf-...
# PHARMA_LANGFUSE__SECRET_KEY=sk-lf-...
# PHARMA_LANGFUSE__HOST=https://cloud.langfuse.com

# Postgres (compose.yaml publishes it on POSTGRES_PORT=5433)
PHARMA_POSTGRES__DSN=postgresql+psycopg://vipharmind:vipharmind@localhost:5433/vipharmind

# Auth (fastapi-users). Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMA_AUTH__JWT_SECRET=
PHARMA_AUTH__CSRF_SECRET=
# PHARMA_AUTH__SESSION_LIFETIME_SECONDS=604800    # browser session cookie lifetime (7 days)
# PHARMA_AUTH__COOKIE_SECURE=true                 # browsers accept Secure cookies on http://localhost
# PHARMA_AUTH__GOOGLE_CLIENT_ID=
# PHARMA_AUTH__GOOGLE_CLIENT_SECRET=
PHARMA_AUTH__FRONTEND_URL=http://localhost:3000

# HTTP API
PHARMA_API__HOST=127.0.0.1
PHARMA_API__PORT=8000
# The browser calls the API on the same origin (nginx or the dev proxy), so CORS stays off.
# PHARMA_API__CORS_ORIGINS=["http://localhost:3000"]

# Account flows: one-time codes are HMAC'd with this secret (at least 32 characters).
PHARMA_AUTH__OTP_SECRET=change-me-to-a-random-string-of-32-characters
# Email: log (local only: codes appear in the backend log) or resend. Until a sending domain
# is verified in Resend, onboarding@resend.dev delivers only to the Resend account's own email.
# PHARMA_EMAIL__PROVIDER=resend
# PHARMA_EMAIL__SENDER=ViPharmind <no-reply@mail.example.com>
# PHARMA_EMAIL__RESEND_API_KEY=re_...
# SMS: `log` writes codes to the log; `none` turns phone sign-in off (production until an
# SMS provider is chosen). Codes are sent only to the countries listed here.
# PHARMA_SMS__PROVIDER=none
# PHARMA_SMS__ALLOWED_COUNTRY_CODES=["VN"]

# Publish jobs: `inprocess` locally (after the request returns), `inline` on Vercel (inside
# the publish request). A job open longer than STALE_AFTER_SECONDS (default 330, just over
# Vercel's 300 s maxDuration) no longer blocks the next publish; raise it when CPU
# embeddings make a local publish slower than that.
# PHARMA_JOBS__DISPATCHER=inline
# PHARMA_JOBS__STALE_AFTER_SECONDS=330

# Daily maintenance (GET /api/v1/maintenance/daily, called by Vercel Cron): expired sessions,
# old codes and rate-limit rows, collections of deleted organizations. Callers must send
# "Authorization: Bearer <CRON_SECRET>"; unset, every call is refused. No PHARMA_ prefix:
# Vercel Cron reads this exact name. Locally, `pharma-agent cleanup-sessions` and
# `pharma-agent corpus purge-deleted` do the same by hand.
# CRON_SECRET=

# Default quotas (spec §2); users and organizations can be given their own by a superadmin.
# PHARMA_QUOTAS__USER_TEXT_BYTES=1000000
# PHARMA_QUOTAS__USER_COLLECTIONS=5
# PHARMA_QUOTAS__ORG_TEXT_BYTES=5000000
# PHARMA_QUOTAS__ORG_COLLECTIONS=20

# Per-IP limits and the session list need the real client IP. Set the number of trusted
# reverse proxies that append to X-Forwarded-For (nginx: 1, Vercel: 1); 0 uses the TCP peer
# and ignores X-Forwarded-For.
# PHARMA_API__TRUSTED_PROXY_HOPS=1
# Shared with the frontend proxy on Vercel (API_PROXY_SECRET): its requests count one hop more.
# PHARMA_API__PROXY_SECRET=
