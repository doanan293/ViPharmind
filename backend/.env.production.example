# Production values for running the CLI from your machine against the deployed services:
#   cp .env.production.example .env.production      # git-ignored; fill in the values below
#   uv run pharma-agent --env-file .env.production migrate
#   uv run pharma-agent --env-file .env.production corpus import ../pharma-lab/data/corpus/formulary --collection formulary --publish
#   uv run pharma-agent --env-file .env.production superadmin grant you@example.com
# devops/vercel/sync_env.py pushes every PHARMA_* name here, and CRON_SECRET, to the Vercel
# project vipharmind-api.
# Only this file is read: backend/.env and PHARMA_* variables of the shell are ignored, except
# that a PHARMA_* variable set in the shell still wins over the file.

# Neon (Singapore), the pooled connection string with sslmode=require
PHARMA_POSTGRES__DSN=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/vipharmind?sslmode=require

# Qdrant Cloud
PHARMA_QDRANT__URL=https://xxxx.cloud.qdrant.io:6333
PHARMA_QDRANT__API_KEY=
# Qdrant Cloud Free has 1 GB of RAM; 4,096-dim vectors of the whole corpus live on disk.
PHARMA_QDRANT__ON_DISK_VECTORS=true

# DeepInfra (the same key for all three)
PHARMA_LLM__DEFAULT__BASE_URL=https://api.deepinfra.com/v1/openai
PHARMA_LLM__DEFAULT__API_KEY=
PHARMA_LLM__DEFAULT__MODEL=Qwen/Qwen3.5-9B
PHARMA_LLM__DEFAULT__EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
PHARMA_RETRIEVAL__EMBEDDING__BASE_URL=https://api.deepinfra.com/v1/openai
PHARMA_RETRIEVAL__EMBEDDING__MODEL=Qwen/Qwen3-Embedding-8B
PHARMA_RETRIEVAL__EMBEDDING__DIMENSION=4096
PHARMA_RETRIEVAL__EMBEDDING__API_KEY=
PHARMA_RETRIEVAL__RERANK__PROTOCOL=deepinfra
PHARMA_RETRIEVAL__RERANK__BASE_URL=https://api.deepinfra.com
PHARMA_RETRIEVAL__RERANK__MODEL=Qwen/Qwen3-Reranker-4B
PHARMA_RETRIEVAL__RERANK__API_KEY=

# Auth and the frontend proxy. Generate each secret (at least 32 characters) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET signs the Google sign-in state; CSRF_SECRET the csrftoken cookie; OTP_SECRET
# the one-time codes.
PHARMA_AUTH__JWT_SECRET=
PHARMA_AUTH__CSRF_SECRET=
PHARMA_AUTH__OTP_SECRET=
# Also set on the frontend project as API_PROXY_SECRET.
PHARMA_API__PROXY_SECRET=

# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to the daily maintenance
# endpoint (backend/vercel.json); at least 32 characters, no PHARMA_ prefix.
CRON_SECRET=

# Email through Resend. Until a domain is verified in
# Resend, use onboarding@resend.dev, which delivers only to the Resend account's own email.
PHARMA_EMAIL__PROVIDER=resend
PHARMA_EMAIL__RESEND_API_KEY=
PHARMA_EMAIL__SENDER=ViPharmind <onboarding@resend.dev>

# Google sign-in: a Web OAuth client in the shared Google Cloud project `andimus`
# (optional; the button hides without it)
# PHARMA_AUTH__GOOGLE_CLIENT_ID=
# PHARMA_AUTH__GOOGLE_CLIENT_SECRET=
