# Optional overrides for `npm run dev`, `npm start` and the frontend container. On Vercel set
# the same three as Environment Variables (Production).
# Backend URL that server-side loaders call, and where /api/* is forwarded when no reverse
# proxy sits in front (Vercel: the Cloud Run URL, e.g. https://vipharmind-api-xxxx.a.run.app).
# API_INTERNAL_URL=http://127.0.0.1:8000
# Public origin for canonical and hreflang URLs; read at build time for prerendered pages
# (Vercel: https://<project>.vercel.app).
# PUBLIC_SITE_URL=http://localhost:8080
# Signs the theme cookie (it only stores light/dark); any random string.
# THEME_COOKIE_SECRET=
