# Optional overrides for `npm run dev`, `npm start` and the frontend container. On Vercel set
# the same four as Environment Variables (Production).
# Backend that the same-origin /api/* proxy forwards to: the api-proxy route in production and
# the Vite dev server in development (Vercel: https://vipharmind-api.vercel.app).
# API_INTERNAL_URL=http://127.0.0.1:8000
# Public origin for canonical and hreflang URLs; read at build time for prerendered pages
# (Vercel: https://<project>.vercel.app).
# PUBLIC_SITE_URL=http://localhost:8080
# Shared with the backend's PHARMA_API__PROXY_SECRET (Vercel only): lets the backend trust the
# client IP this proxy forwards.
# API_PROXY_SECRET=
# Signs the theme cookie (it only stores light/dark); any random string.
# THEME_COOKIE_SECRET=
