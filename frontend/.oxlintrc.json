{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    ".react-router/**",
    "app/api/gen/**",
    "public/mockServiceWorker.js"
  ],
  "overrides": [
    {
      "files": [
        "app/api/**",
        "app/components/**",
        "app/hooks/**",
        "app/i18n/**",
        "app/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/features",
                  "~/features/**",
                  "~/routes",
                  "~/routes/**"
                ],
                "message": "Shared code (api, components, hooks, i18n, lib) must not depend on features or routes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/features/audit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["~/routes", "~/routes/**"],
                "message": "Features must not import routes; routes compose features."
              },
              {
                "group": [
                  "~/features/auth",
                  "~/features/auth/**",
                  "~/features/chat",
                  "~/features/chat/**",
                  "~/features/conversations",
                  "~/features/conversations/**",
                  "~/features/landing",
                  "~/features/landing/**",
                  "~/features/organizations",
                  "~/features/organizations/**",
                  "~/features/settings",
                  "~/features/settings/**",
                  "~/features/shell",
                  "~/features/shell/**"
                ],
                "message": "features/audit must not import other features; compose features in routes instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/features/auth/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["~/routes", "~/routes/**"],
                "message": "Features must not import routes; routes compose features."
              },
              {
                "group": [
                  "~/features/audit",
                  "~/features/audit/**",
                  "~/features/chat",
                  "~/features/chat/**",
                  "~/features/conversations",
                  "~/features/conversations/**",
                  "~/features/landing",
                  "~/features/landing/**",
                  "~/features/organizations",
                  "~/features/organizations/**",
                  "~/features/settings",
                  "~/features/settings/**",
                  "~/features/shell",
                  "~/features/shell/**"
                ],
                "message": "features/auth must not import other features; compose features in routes instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/features/chat/**"],
