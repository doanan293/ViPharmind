{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!build",
      "!.react-router",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!package-lock.json",
      "!openapi.json",
      "!tests/public/mockServiceWorker.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    },
    "includes": ["**", "!app/api/gen/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60,
            "skipBlankLines": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "noMagicNumbers": "error",
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noImportCycles": "error",
        "noExplicitAny": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error",
        "noBaseToString": "error",
        "noMisusedSpread": "error",
        "noUnsafeUnaryMinus": "error",
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        },
        "noTailwindConflictingClasses": "error"
      }
    },
    "includes": ["**", "!app/api/gen/**"]
  },
  "overrides": [
    {
      "includes": [
        "app/api/**",
        "app/components/**",
        "app/hooks/**",
        "app/i18n/**",
        "app/lib/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features",
                      "~/features/**",
                      "~/routes",
                      "~/routes/**"
                    ],
                    "message": "Shared code (api, components, hooks, i18n, lib) must not depend on features or routes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/features/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["~/routes", "~/routes/**"],
                    "message": "Features must not import routes; routes compose features."
                  },
                  {
                    "group": [
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/features/conversations",
                      "~/features/conversations/**",
                      "~/features/landing",
                      "~/features/landing/**",
                      "~/features/legal",
                      "~/features/legal/**",
                      "~/features/organizations",
                      "~/features/organizations/**",
                      "~/features/settings",
                      "~/features/settings/**",
                      "~/features/shell",
                      "~/features/shell/**"
                    ],
                    "message": "features/admin may only import features/auth, features/chat, features/audit; compose features in routes instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
