# Shared rules (Python caches, virtualenvs, .env, logs, editors) live in the repository root .gitignore.

# Temporary runtime directories
tmp/
temp/

# Kaggle local state and job workspaces
.kaggle/
pharma-lab-kaggle-*/

# Large or generated data lives in the Kaggle archive (`pharma-lab data push` / `pharma-lab data pull`).
data/sources/**/*.pdf
data/sources/leaflets/html/
data/corpus/**
!data/corpus/**/
!data/corpus/**/manifest.json
!data/corpus/**/validation_report.json
data/evaluation/gold*/
data/evaluation/runs/**
!data/evaluation/runs/**/
!data/evaluation/runs/**/run.json
!data/evaluation/runs/**/manifest.json
!data/evaluation/runs/**/report.md
# v1 runs that registered fp16 rerankers, which this version's Q8_0 catalog no longer has:
# kept on disk (dev-test and slices read them) and archived, not tracked.
data/evaluation/runs/hybrid-qwen4b-p50-k30-rrf2/
data/evaluation/runs/hybrid-qwen4b-p50-k30-rrf2-sample1000/
data/evaluation/e2e/**
!data/evaluation/e2e/**/
!data/evaluation/e2e/golden_e2e.manifest.json
!data/evaluation/e2e/runs/**/run.json
!data/evaluation/e2e/runs/**/reports/**
data/cache/
data/work/
